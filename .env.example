# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real credentials. BASE_URL/TEST_PROJECT_NAME/HEADLESS have working
# defaults in tests/config.js / playwright.config.ts and only need to be set
# here if you want to override them (e.g. to switch DEV/PROD). The test
# account (TEST_USER_EMAIL/TEST_USER_PASSWORD) has no default and MUST be set.

# --- Environment -------------------------------------------------------
# Switches the ENTIRE suite between environments. playwright.config.ts reads
# this into Playwright's `baseURL`, and every spec/helper navigates with
# relative paths (page.goto('/sign-in'), navigation.js's gotoClients(), etc.)
# — nothing hardcodes a host, so this one line is the only thing to change.
BASE_URL=https://platform.getlaunched.io/
# BASE_URL=https://local.getlaunched.io:3000   # local dev build, see README.md

# --- Test account --------------------------------------------------------
# Read by tests/config.js. TEST_EMAIL/TEST_PASSWORD/TEST_PROJECT (no "USER"/
# "_NAME") also still work as fallback aliases for the same variables.
# Required — tests/config.js throws at startup if these are unset, rather
# than falling back to a real account hardcoded in source.
TEST_USER_EMAIL=you@example.com
TEST_USER_PASSWORD=ChangeMe123!
# Name of the project the suite bootstraps and reuses (created automatically
# on a fresh account; an existing leftover project is adopted+renamed to
# this if the account can't create a new one — see tests/helpers/project.js).
TEST_PROJECT_NAME=Autotest Project

# --- CI ---------------------------------------------------------------
# HEADLESS=1 npx playwright test --project=chromium
HEADLESS=
